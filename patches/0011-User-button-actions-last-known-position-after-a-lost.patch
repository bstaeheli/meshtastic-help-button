From 2375c33988ddedf3d9af4feb4bb81505b73de7d6 Mon Sep 17 00:00:00 2001
From: =?UTF-8?q?Boris=20Sta=CC=88heli?= <ich@bstaehe.li>
Date: Fri, 23 Oct 2026 20:31:20 +0200
Subject: [PATCH 11/12] User button actions: last known position after a lost
 GPS lock
MIME-Version: 1.0
Content-Type: text/plain; charset=UTF-8
Content-Transfer-Encoding: 8bit

- GPS.cpp/MeshService clear localPosition when the GPS loses lock. Keep
  the last fix since boot (a fixed position counts) and use it for the
  map link of HELP/SOS, with its age, e.g. "±25m 7min old".
- The position packet sent with an alert carries that last fix too,
  built by PositionModule with the channel precision and the original
  timestamp; no packet without a fix since boot or at precision 0.
- Without a fix since boot the text says "no GPS fix"; at precision 0
  it stays plain.
- Limit alert texts to 200 bytes: at 233 the Data fields Router adds do
  not fit and the alert was dropped as TOO_LARGE. The suffix is left out
  instead; the alert text itself is never cut.
---
 src/input/UserButtonActions.cpp             | 45 +++++++++++++++--
 src/input/UserButtonActions.h               | 33 +++++++++---
 test/test_user_button_actions/test_main.cpp | 56 +++++++++++++++++++--
 3 files changed, 117 insertions(+), 17 deletions(-)

diff --git a/src/input/UserButtonActions.cpp b/src/input/UserButtonActions.cpp
index 355bfa5c0..55461fd0e 100644
--- a/src/input/UserButtonActions.cpp
+++ b/src/input/UserButtonActions.cpp
@@ -5,11 +5,15 @@
 #include "NodeDB.h"
 #include "PowerFSM.h"
 #include "Router.h"
+#include "TypeConversions.h"
 #include "UserButtonActions.h"
 #include "buzz/BuzzerFeedbackThread.h"
 #include "buzz/buzz.h"
 #include "gps/RTC.h"
 #include "modules/ExternalNotificationModule.h"
+#if !MESHTASTIC_EXCLUDE_GPS
+#include "modules/PositionModule.h"
+#endif
 
 // Same packet construction as CannedMessageModule::sendText, but broadcast on the primary channel without ack
 static void sendTextBroadcast(const char *text)
@@ -32,6 +36,36 @@ static void sendAdHocPosition(bool wantReplies)
     service->trySendPosition(NODENUM_BROADCAST, wantReplies);
 }
 
+static meshtastic_Position lastFix = meshtastic_Position_init_default;
+
+// Last fix since boot; a fixed position counts as one, like in PositionModule (without an age)
+static void rememberFix()
+{
+    meshtastic_Position current = localPosition;
+    const meshtastic_NodeInfoLite *node = nodeDB->getMeshNode(nodeDB->getNodeNum());
+    if (config.position.fixed_position && !current.latitude_i && !current.longitude_i && node) {
+        current = TypeConversions::ConvertToPosition(node->position);
+        current.time = current.timestamp = 0;
+    }
+    userButtonActionsRememberFix(lastFix, current, config.position.fixed_position || nodeDB->hasLocalPositionSinceBoot());
+}
+
+// Position packet with the last fix, also after the GPS lost lock (stock would send none). PositionModule builds it
+// from localPosition with the channel precision, so swap the last fix in for this one packet.
+static void sendLastFix()
+{
+#if !MESHTASTIC_EXCLUDE_GPS
+    if (!positionModule || (!lastFix.latitude_i && !lastFix.longitude_i))
+        return;
+    meshtastic_Position current = localPosition;
+    localPosition = lastFix;
+    service->refreshLocalMeshNode();
+    positionModule->sendOurPosition(NODENUM_BROADCAST, false, 0);
+    current.seq_number = localPosition.seq_number;
+    localPosition = current;
+#endif
+}
+
 // Button feedback as stock would give it for this event (honors buzzer_mode)
 static void playFeedback(input_broker_event event)
 {
@@ -54,6 +88,7 @@ bool userButtonActionsTick(bool buttonPressed, uint32_t holdMs)
 
     if (buttonPressed)
         state.lastPressedMs = millis();
+    rememberFix();
 
     const UserButtonActionsConfig &cfg = userButtonActionsConfig();
     if (!buttonPressed || state.pressConsumed || !cfg.long_press_shutdown_ms)
@@ -101,14 +136,14 @@ bool userButtonActionsHandle(UserButtonGesture gesture, uint32_t holdMs, uint32_
         LOG_INFO("User button: send alert level %d", outcome == UBA_OUTCOME_ALERT2 ? 2 : 1);
         // Map link only to what the position packet on the primary channel reveals
         char text[meshtastic_Constants_DATA_PAYLOAD_LEN + 1];
-        const uint32_t precision =
-            cfg.alert_with_position && nodeDB->hasLocalPositionSinceBoot() ? getPositionPrecisionForChannel(0) : 0;
-        userButtonActionsAlertText(text, sizeof(text), outcome == UBA_OUTCOME_ALERT2 ? cfg.alert2_text : cfg.alert_text,
-                                   localPosition, precision, getValidTime(RTCQualityDevice));
+        const uint32_t precision = cfg.alert_with_position ? getPositionPrecisionForChannel(0) : 0;
+        rememberFix();
+        userButtonActionsAlertText(text, sizeof(text), outcome == UBA_OUTCOME_ALERT2 ? cfg.alert2_text : cfg.alert_text, lastFix,
+                                   precision, getValidTime(RTCQualityDevice));
         sendTextBroadcast(text);
         state.limiters[outcome == UBA_OUTCOME_ALERT2].alertSent(state.nowMs);
         if (cfg.alert_with_position)
-            sendAdHocPosition(false);
+            sendLastFix();
         playFeedback(INPUT_BROKER_USER_PRESS);
         break;
     }
diff --git a/src/input/UserButtonActions.h b/src/input/UserButtonActions.h
index 77456f4da..9dff47d51 100644
--- a/src/input/UserButtonActions.h
+++ b/src/input/UserButtonActions.h
@@ -268,15 +268,36 @@ inline uint8_t userButtonActionsMapZoom(uint32_t accuracyM)
     return zoom;
 }
 
+// Text bytes that always fit a packet: Router adds the Data fields (port, length, bitfield) to the payload
+static const size_t UBA_MAX_TEXT_LEN = 200;
+
+// Keeps the last fix since boot: GPS.cpp/MeshService clear localPosition when the GPS loses lock
+inline void userButtonActionsRememberFix(meshtastic_Position &lastFix, const meshtastic_Position &current, bool fixSinceBoot)
+{
+    if (!fixSinceBoot)
+        lastFix = meshtastic_Position_init_default;
+    else if (current.latitude_i || current.longitude_i)
+        lastFix = current;
+}
+
 // Alert text plus a map link to the position as the position packet would reveal it, e.g.
-// "\aHELP https://osm.org/go/0C0WCb6VB--?m ±25m 4min old". precision: channel position_precision, 0 = no link.
-// nowSecs: valid time, 0 = unknown. The link is left out if it does not fit. Returns the text length.
+// "\aHELP https://osm.org/go/0C0WCb6VB--?m ±25m 4min old", or "\aHELP no GPS fix" without a position.
+// precision: channel position_precision, 0 = plain text. nowSecs: valid time, 0 = unknown.
+// The suffix is left out if the text would exceed UBA_MAX_TEXT_LEN; the alert is never cut. Returns the text length.
 inline size_t userButtonActionsAlertText(char *buf, size_t size, const char *alert, meshtastic_Position pos, uint32_t precision,
                                          uint32_t nowSecs)
 {
-    int len = snprintf(buf, size, "%s", alert);
-    if (len < 0 || (size_t)len >= size || !precision || (!pos.latitude_i && !pos.longitude_i))
+    const int len = snprintf(buf, size, "%s", alert);
+    auto append = [&](const char *suffix) {
+        const size_t total = len + strlen(suffix);
+        if (total < size && total <= UBA_MAX_TEXT_LEN)
+            strcpy(buf + len, suffix);
+        return strlen(buf);
+    };
+    if (len < 0 || (size_t)len >= size || !precision)
         return len < 0 ? 0 : strlen(buf);
+    if (!pos.latitude_i && !pos.longitude_i)
+        return append(" no GPS fix");
 
     // Accuracy ~ 5 m per DOP (1/100 units) rounded to 5 m, at least the radius of the precision cell
     const uint32_t dop = pos.HDOP ? pos.HDOP : pos.PDOP;
@@ -307,9 +328,7 @@ inline size_t userButtonActionsAlertText(char *buf, size_t size, const char *ale
         else
             snprintf(link + n, sizeof(link) - n, " %ud old", (unsigned)(mins / 1440));
     }
-    if ((size_t)len + strlen(link) < size)
-        strcpy(buf + len, link);
-    return strlen(buf);
+    return append(link);
 }
 
 // Runs the configured action. Returns true if the gesture was handled and stock handling must be skipped.
diff --git a/test/test_user_button_actions/test_main.cpp b/test/test_user_button_actions/test_main.cpp
index 987682516..1efb41a15 100644
--- a/test/test_user_button_actions/test_main.cpp
+++ b/test/test_user_button_actions/test_main.cpp
@@ -479,7 +479,41 @@ static void test_alert_without_position_sharing_is_plain()
     TEST_ASSERT_EQUAL_STRING("\aHELP", alertText(fix(), 0));
     meshtastic_Position p = fix();
     p.latitude_i = p.longitude_i = 0;
-    TEST_ASSERT_EQUAL_STRING("\aHELP", alertText(p, 32)); // no fix
+    TEST_ASSERT_EQUAL_STRING("\aHELP", alertText(p, 0)); // position withheld on purpose: no note
+}
+
+static void test_alert_without_fix_says_so()
+{
+    meshtastic_Position p = fix();
+    p.latitude_i = p.longitude_i = 0;
+    TEST_ASSERT_EQUAL_STRING("\aHELP no GPS fix", alertText(p, 32));
+    TEST_ASSERT_EQUAL_STRING("\aSOS no GPS fix", alertText(p, 16, 1000000, "\aSOS"));
+}
+
+static void test_last_fix_survives_lost_lock()
+{
+    meshtastic_Position last = meshtastic_Position_init_default;
+    meshtastic_Position lost = meshtastic_Position_init_default;
+    userButtonActionsRememberFix(last, fix(), true);
+    TEST_ASSERT_EQUAL(473769000, last.latitude_i);
+    userButtonActionsRememberFix(last, lost, true); // GPS lost lock: localPosition cleared
+    TEST_ASSERT_EQUAL(473769000, last.latitude_i);
+    TEST_ASSERT_EQUAL(1000000, last.timestamp);
+    TEST_ASSERT_EQUAL_STRING("\aHELP https://osm.org/go/0C0WCb6VB--?m \xC2\xB1"
+                             "25m 7min old",
+                             alertText(last, 32, 1000000 + 7 * 60));
+    meshtastic_Position newer = fix();
+    newer.timestamp = 1000500;
+    userButtonActionsRememberFix(last, newer, true);
+    TEST_ASSERT_EQUAL(1000500, last.timestamp);
+}
+
+static void test_last_fix_forgotten_without_fix_since_boot()
+{
+    meshtastic_Position last = fix();
+    userButtonActionsRememberFix(last, fix(), false); // e.g. a position saved before reboot or a cleared node DB
+    TEST_ASSERT_EQUAL(0, last.latitude_i);
+    TEST_ASSERT_EQUAL(0, last.longitude_i);
 }
 
 static void test_alert_link_respects_channel_precision()
@@ -496,12 +530,21 @@ static void test_alert_link_respects_channel_precision()
                              alertText(fix(0), 16)); // radius shown even without DOP
 }
 
+static const char *repeatX(size_t n)
+{
+    static char text[256];
+    memset(text, 'x', n);
+    text[n] = 0;
+    return text;
+}
+
 static void test_alert_link_dropped_when_too_long()
 {
-    char alert[meshtastic_Constants_DATA_PAYLOAD_LEN - 20];
-    memset(alert, 'x', sizeof(alert) - 1);
-    alert[sizeof(alert) - 1] = 0;
-    TEST_ASSERT_EQUAL_STRING(alert, alertText(fix(), 32, 1000000, alert));
+    // The link of fix() is 39 bytes; Router needs room for its Data fields, so stay at UBA_MAX_TEXT_LEN
+    TEST_ASSERT_EQUAL(UBA_MAX_TEXT_LEN, strlen(alertText(fix(), 32, 1000000, repeatX(UBA_MAX_TEXT_LEN - 39))));
+    TEST_ASSERT_EQUAL_STRING(repeatX(UBA_MAX_TEXT_LEN - 38), alertText(fix(), 32, 1000000, repeatX(UBA_MAX_TEXT_LEN - 38)));
+    TEST_ASSERT_EQUAL_STRING(repeatX(UBA_MAX_TEXT_LEN + 10), alertText(fix(), 32, 1000000, repeatX(UBA_MAX_TEXT_LEN + 10)));
+    TEST_ASSERT_TRUE(UBA_MAX_TEXT_LEN + 7 <= meshtastic_Constants_DATA_PAYLOAD_LEN); // Data encoding overhead
     char small[16];
     TEST_ASSERT_EQUAL(5, userButtonActionsAlertText(small, sizeof(small), "\aHELP", fix(), 32, 1000000));
     TEST_ASSERT_EQUAL_STRING("\aHELP", small);
@@ -562,6 +605,9 @@ void setup()
     RUN_TEST(test_alert_accuracy_from_hdop_or_pdop);
     RUN_TEST(test_alert_link_shows_age_of_old_fix);
     RUN_TEST(test_alert_without_position_sharing_is_plain);
+    RUN_TEST(test_alert_without_fix_says_so);
+    RUN_TEST(test_last_fix_survives_lost_lock);
+    RUN_TEST(test_last_fix_forgotten_without_fix_since_boot);
     RUN_TEST(test_alert_link_respects_channel_precision);
     RUN_TEST(test_alert_link_dropped_when_too_long);
     exit(UNITY_END());
